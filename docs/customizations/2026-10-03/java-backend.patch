+          HttpResponse denied = TioRequestContext.getResponse();
+          denied.setStatus(HttpResponseStatus.C401);
+          return denied;
+        }
+      }
+      String path = requestLine.getPath();
+      if ((path.startsWith("/api/user_manage") || path.startsWith("/api/email_setting") || path.startsWith("/api/team"))
+          && (!member || !"ADMIN".equalsIgnoreCase(account.getStr("role")))) {
+        HttpResponse denied = TioRequestContext.getResponse();
+        denied.setStatus(HttpResponseStatus.C403);
+        return denied;
+      }
+      if (!member && !(path.equals("/api/application/profile")
+          || path.matches("/api/application/\\d+/chat/open")
+          || path.matches("/api/application/chat_message/\\d+")
+          || path.matches("/api/application/\\d+/chat/\\d+/context(/compact)?")
+          || path.matches("/api/application/\\d+/chat/client/\\d+(/\\d+)?")
+          || path.matches("/api/application/\\d+/chat/\\d+/chat_record/\\d+/\\d+")
+          || path.matches("/api/application/\\d+/chat/\\d+/chat_record/\\d+(/vote)?"))) {
+        HttpResponse denied = TioRequestContext.getResponse();
+        denied.setStatus(HttpResponseStatus.C403);
+        return denied;
+      }
+      if (member && userId != 1L) {
+        java.util.regex.Matcher resource = java.util.regex.Pattern.compile("^/api/(dataset|application|model)/(\\d+)(/.*)?$").matcher(path);
+        if (resource.matches()) {
+          String type = resource.group(1);
+          String suffix = resource.group(3);
+          boolean page = !"model".equals(type) && suffix != null && suffix.matches("/\\d+");
+          boolean chat = "application".equals(type) && suffix != null && suffix.startsWith("/chat/");
+          Long id = Long.valueOf(resource.group(2));
+          boolean owns = page || chat || ("dataset".equals(type)
+              ? nexus.io.mosskb.service.kb.DatasetAccess.owns(userId, id)
+              : "application".equals(type) ? nexus.io.mosskb.service.kb.ApplicationAccess.owns(userId, id)
+              : nexus.io.mosskb.service.kb.ModelAccess.owns(userId, id));
+          if (owns && "dataset".equals(type) && suffix != null) {
+            for (String child : new String[] {"document", "paragraph", "problem"}) {
+              java.util.regex.Matcher childId = java.util.regex.Pattern.compile("/" + child + "/(\\d+)(?=/[a-z_]|$)").matcher(suffix);
