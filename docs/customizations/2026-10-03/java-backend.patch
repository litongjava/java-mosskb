+      boolean member = account != null;
+      if (member && (!Boolean.TRUE.equals(account.getBoolean("is_active")) || account.getInt("deleted") != 0)) {
+        HttpResponse denied = TioRequestContext.getResponse();
+        denied.setStatus(HttpResponseStatus.C401);
