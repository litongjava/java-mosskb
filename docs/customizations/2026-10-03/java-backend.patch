diff --git a/mosskb-business/src/test/java/nexus/io/mosskb/service/kb/IsolatedPythonExecutorTest.java b/mosskb-business/src/test/java/nexus/io/mosskb/service/kb/IsolatedPythonExecutorTest.java
new file mode 100644
