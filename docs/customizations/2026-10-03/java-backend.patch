+    "-Docr.pdf=$pdfFile",
+    "-Docr.output=$OutputDirectory",
+    "-Docr.timeoutMinutes=$TimeoutMinutes"
+  )
+  if ($Models) { $jvmArguments += "-Docr.models=$Models" }
+  & java @jvmArguments -cp $benchmarkClasspath nexus.io.mosskb.ocr.DocumentOcrBenchmarkTest
